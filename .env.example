# Luvvv-agent 环境变量模板（不包含任何敏感信息，可入 git）
# 复制为 .env 后填入你自己的 key/token:
#   cp .env.example .env
#   vim .env

# ===== LLM API（ccwitch / Anthropic 兼容协议）=====
# 从 ccwitch / Anthropic 控制台拿
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== TSec Benchmark 平台凭证（真平台跑分用）=====
BENCHMARK_TOKEN=
BENCHMARK_BASE_URL=

# ===== 可选微调 =====
# LUVVV_MODEL_PROVIDER=anthropic   # anthropic | claude | mock
# ANTHROPIC_API_TIMEOUT_MS=300000
